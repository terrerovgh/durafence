---
import Monogram from './Monogram.astro';
import ServiceIcon from './ServiceIcon.astro';
import { site } from '../data/site';
import { trades } from '../data/services';
---

<div class="composition relative z-10 mx-auto flex w-full max-w-[600px] flex-col items-center text-center sm:block sm:h-[640px] sm:w-[640px] sm:max-w-none">
  <Monogram idPrefix="hero" class="logo h-auto w-[min(115vw,460px)] max-w-none sm:absolute sm:top-0 sm:left-0 sm:h-[320px] sm:w-[640px]" />

  <h1 class="metal-title mt-3 text-[clamp(1.9rem,10vw,4.15rem)] leading-none font-black tracking-[.005em] uppercase whitespace-nowrap sm:absolute sm:top-[330px] sm:left-[40px] sm:mt-0 sm:w-[560px] sm:scale-x-[1.06] sm:text-[57px]">
    {site.shortName}
  </h1>

  <div class="metal-lockup relative mt-2 flex w-full max-w-[560px] items-center justify-center gap-4 sm:absolute sm:top-[403px] sm:left-[42px] sm:mt-0 sm:w-[556px] sm:gap-5" aria-label={site.metal}>
    <span class="gold-rule h-px min-w-0 flex-1" aria-hidden="true"></span>
    <p class="metal-subtitle pl-[.9em] text-[clamp(1.5rem,5.8vw,2.15rem)] leading-none font-semibold tracking-[.9em] uppercase">{site.metal}</p>
    <span class="gold-rule gold-rule-right h-px min-w-0 flex-1" aria-hidden="true"></span>
  </div>

  <p class="mt-3 text-[clamp(.52rem,1.45vw,.67rem)] leading-relaxed font-light tracking-[.36em] text-[#c6c7ca] uppercase sm:absolute sm:top-[443px] sm:left-0 sm:mt-0 sm:w-full sm:tracking-[.9em] sm:whitespace-nowrap">
    {site.tagline}
  </p>

  <nav class="mt-8 w-full sm:absolute sm:top-[487px] sm:left-0 sm:mt-0 sm:w-full" aria-label="Product catalog">
    <ul class="grid grid-cols-2 gap-y-7 sm:grid-cols-4 sm:gap-y-0">
      {trades.map((service, index) => (
        <li class:list={['sm:min-h-[56px]', { 'sm:border-l sm:border-[#777777]/55': index > 0 }]}>
          <a href={service.href} class="flex min-h-[72px] flex-col items-center justify-start px-2 text-[#d0d1d3] no-underline hover:text-white sm:min-h-[56px]">
            <ServiceIcon name={service.icon} class="mb-2 h-7 w-7 text-[#d9ac66] drop-shadow-[0_0_7px_rgba(219,160,78,.2)] sm:mb-1" />
            <span class="text-[.64rem] leading-[1.2] font-medium tracking-[.14em] uppercase sm:leading-[1.35]">
              {service.name[0]}<br />{service.name[1]}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <a href="/service-area/" class="mt-10 flex w-full max-w-[390px] items-center justify-center gap-5 text-[#b9bbbf] no-underline hover:text-white sm:absolute sm:top-[587px] sm:left-[125px] sm:mt-0 sm:w-[390px]" aria-label={`${site.region}, service area`}>
    <span class="h-px flex-1 bg-gradient-to-r from-transparent to-[#8c8d90]/70" aria-hidden="true"></span>
    <span class="pl-[.4em] text-[.66rem] leading-none font-medium tracking-[.4em] uppercase whitespace-nowrap sm:tracking-[.55em]">{site.region}</span>
    <span class="h-px flex-1 bg-gradient-to-l from-transparent to-[#8c8d90]/70" aria-hidden="true"></span>
  </a>
</div>
