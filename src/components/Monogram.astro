---
interface Props {
  idPrefix?: string;
  crop?: boolean;
  class?: string;
}

const { idPrefix = 'mono', crop = false, class: className } = Astro.props;
const p = idPrefix;
---

<svg
  class:list={['overflow-visible', className]}
  viewBox={crop ? '168 42 310 276' : '0 0 640 320'}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${p}-steel`} x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0" stop-color="#eeeeef"></stop>
      <stop offset=".18" stop-color="#fafafa"></stop>
      <stop offset=".45" stop-color="#d1d2d4"></stop>
      <stop offset=".75" stop-color="#a5a7aa"></stop>
      <stop offset="1" stop-color="#898b8d"></stop>
    </linearGradient>
    <linearGradient id={`${p}-pillar`} x1="0" x2="1" y1="0" y2=".15">
      <stop offset="0" stop-color="#f5f5f6"></stop>
      <stop offset=".14" stop-color="#b9babd"></stop>
      <stop offset=".56" stop-color="#77797c"></stop>
      <stop offset=".88" stop-color="#38393a"></stop>
      <stop offset="1" stop-color="#161616"></stop>
    </linearGradient>
    <linearGradient id={`${p}-dark`} x1="0" x2="1" y1="0" y2=".4">
      <stop offset="0" stop-color="#b4b5b7"></stop>
      <stop offset=".24" stop-color="#77787a"></stop>
      <stop offset=".7" stop-color="#292a2b"></stop>
      <stop offset="1" stop-color="#111111"></stop>
    </linearGradient>
    <linearGradient id={`${p}-gold`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#a16e35"></stop>
      <stop offset=".5" stop-color="#ffe1a4"></stop>
      <stop offset="1" stop-color="#b77c3b"></stop>
    </linearGradient>
    <filter id={`${p}-glow`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5"></feGaussianBlur>
    </filter>
    <pattern id={`${p}-grain`} width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(-12)">
      <path d="M0 .5h3" stroke="#fff" stroke-opacity=".055" stroke-width=".35"></path>
      <path d="M0 2h3" stroke="#111" stroke-opacity=".045" stroke-width=".3"></path>
    </pattern>
    <radialGradient id={`${p}-halo`}>
      <stop offset="0" stop-color="#b9762c" stop-opacity=".07"></stop>
      <stop offset=".5" stop-color="#9c6021" stop-opacity=".025"></stop>
      <stop offset="1" stop-color="#9c6021" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <g transform="translate(139 48) scale(.97 .94)">
    <ellipse cx="216" cy="157" rx="125" ry="133" fill={`url(#${p}-halo)`}></ellipse>
    <path d="M81 285V43l36 21M166 285V65M170 66h57c50 0 81 39 81 91s-31 92-82 92" fill="none" stroke="#dd9241" stroke-width="10" opacity=".72" filter={`url(#${p}-glow)`}></path>
    <path d="M81 285V43l36 21M166 285V65M170 66h57c50 0 81 39 81 91s-31 92-82 92" fill="none" stroke={`url(#${p}-gold)`} stroke-width="1.8" opacity=".98"></path>

    <path d="M32 96 68 120v165H32Z" fill={`url(#${p}-dark)`}></path>
    <path d="M32 96 68 120v165H32Z" fill={`url(#${p}-grain)`}></path>
    <path d="M32 96v189" stroke="#f5f5f5" stroke-opacity=".36" stroke-width=".8"></path>
    <path d="M68 120v165" stroke="#080808" stroke-opacity=".9" stroke-width="2"></path>
    <path d="M83 43 117 65v220H83Z" fill={`url(#${p}-dark)`}></path>
    <path d="M83 43 117 65v220H83Z" fill={`url(#${p}-grain)`}></path>
    <path d="M83 43v242" stroke="#ffd69b" stroke-opacity=".7" stroke-width="1.1"></path>
    <path d="M117 65v220" stroke="#080808" stroke-opacity=".9" stroke-width="2"></path>
    <path d="M128 0 163 25v260h-35Z" fill={`url(#${p}-pillar)`}></path>
    <path d="M128 0 163 25v260h-35Z" fill={`url(#${p}-grain)`}></path>
    <path d="M128 0v285" stroke="#fff" stroke-opacity=".72" stroke-width="1"></path>
    <path d="M163 25v260" stroke="#111" stroke-opacity=".85" stroke-width="1.7"></path>

    <path d="M174 92v193h34V116Z" fill={`url(#${p}-dark)`}></path>
    <path d="M174 92v193h34V116Z" fill={`url(#${p}-grain)`}></path>
    <path d="M174 92v193" stroke="#ffd59a" stroke-opacity=".8" stroke-width="1"></path>
    <path d="M219 134v115h34v-91Z" fill={`url(#${p}-dark)`}></path>
    <path d="M219 134v115h34v-91Z" fill={`url(#${p}-grain)`}></path>
    <path d="M219 134v115" stroke="#fff" stroke-opacity=".28" stroke-width=".8"></path>

    <path d="M170 26h65c64 0 109 46 109 130 0 75-49 129-119 129h-52l47-36h6c48 0 79-36 79-92 0-54-30-94-78-94h-57Z" fill={`url(#${p}-steel)`}></path>
    <path d="M170 26h65c64 0 109 46 109 130 0 75-49 129-119 129h-52l47-36h6c48 0 79-36 79-92 0-54-30-94-78-94h-57Z" fill={`url(#${p}-grain)`}></path>
    <path d="M170 26h65c64 0 109 46 109 130" fill="none" stroke="#fff" stroke-opacity=".32" stroke-width="1.3"></path>
    <path d="M170 63h57c48 0 78 40 78 94 0 56-31 92-79 92" fill="none" stroke="#101010" stroke-opacity=".78" stroke-width="2"></path>
  </g>
</svg>
