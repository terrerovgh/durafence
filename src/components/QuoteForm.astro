---
import { site } from '../data/site';
---

<form class="relative" method="post" action="/api/quote" data-quote-form data-email={site.email} novalidate>
  <div class="hp" aria-hidden="true">
    <label>
      Company
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="grid gap-x-10 sm:grid-cols-2">
    <div class="py-4">
      <label class="kicker" for="quote-name">Name</label>
      <input class="field-input mt-2" id="quote-name" name="name" autocomplete="name" maxlength="120" />
      <p class="mt-2 text-sm text-white" id="quote-name-error" data-error-for="name" hidden></p>
    </div>
    <div class="py-4">
      <label class="kicker" for="quote-phone">Phone</label>
      <input class="field-input mt-2" id="quote-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" inputmode="tel" />
      <p class="mt-2 text-sm text-white" id="quote-phone-error" data-error-for="phone" hidden></p>
    </div>
    <div class="py-4">
      <label class="kicker" for="quote-email">Email</label>
      <input class="field-input mt-2" id="quote-email" name="email" type="email" autocomplete="email" maxlength="120" />
      <p class="mt-2 text-sm text-white" id="quote-email-error" data-error-for="email" hidden></p>
    </div>
    <div class="py-4">
      <label class="kicker" for="quote-city">City</label>
      <input class="field-input mt-2" id="quote-city" name="city" autocomplete="address-level2" maxlength="80" />
      <p class="mt-2 text-sm text-white" id="quote-city-error" data-error-for="city" hidden></p>
    </div>
  </div>

  <fieldset class="mt-8 border-0 p-0">
    <legend class="kicker">Property</legend>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="property" value="residential" />
        <span>Residential</span>
      </label>
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="property" value="commercial" />
        <span>Commercial</span>
      </label>
    </div>
    <p class="mt-2 text-sm text-white" id="quote-property-error" data-error-for="property" hidden></p>
  </fieldset>

  <fieldset class="mt-8 border-0 p-0">
    <legend class="kicker">Work</legend>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="work" value="new" />
        <span>New fence</span>
      </label>
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="work" value="replace" />
        <span>Replacement</span>
      </label>
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="work" value="gate" />
        <span>Gate only</span>
      </label>
      <label class="flex items-center gap-3 border border-line px-3 py-3">
        <input type="radio" name="work" value="repair" />
        <span>Parts or other request</span>
      </label>
    </div>
    <p class="mt-2 text-sm text-white" id="quote-work-error" data-error-for="work" hidden></p>
  </fieldset>

  <div class="mt-8 py-4">
    <label class="kicker" for="quote-length">Approximate length</label>
    <select class="field-select mt-2" id="quote-length" name="length">
      <option value="">Leave blank if you are not sure</option>
      <option value="under-100">Under 100 ft</option>
      <option value="100-300">100–300 ft</option>
      <option value="over-300">More than 300 ft</option>
      <option value="unknown">I don't know yet</option>
    </select>
    <p class="mt-2 text-sm text-white" id="quote-length-error" data-error-for="length" hidden></p>
  </div>

  <div class="mt-8">
    <label class="kicker" for="quote-message">Products and project details</label>
    <textarea class="field-area mt-3" id="quote-message" name="message" maxlength="2000" placeholder="Fence height and finish, gate type and width, part names and quantities, or drawings needed."></textarea>
    <p class="mt-2 text-sm text-white" id="quote-message-error" data-error-for="message" hidden></p>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-5">
    <button class="btn-steel" type="submit">Send the request</button>
    <a class="link-quiet text-sm" href="/privacy/">Privacy</a>
  </div>

  <div class="mt-6 max-w-prose text-steel" data-status role="status"></div>
  <div data-copy hidden>
    <pre class="mt-4 overflow-x-auto border border-line p-4 text-sm whitespace-pre-wrap text-muted" data-copy-text tabindex="0"></pre>
    <button class="btn-steel mt-4" type="button" data-copy-button>Copy request</button>
  </div>
</form>

<script>
  import { mountQuoteForm } from '../scripts/quote-form';
  mountQuoteForm();
</script>
