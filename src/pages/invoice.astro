---
import '../styles/global.css';
import '../invoice/dashboard.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/michroma/latin-400.css';
import Monogram from '../components/Monogram.astro';
---
<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex, nofollow' />
    <meta name='referrer' content='no-referrer' />
    <title>Invoices | Dura Fence Metal</title>
    <link rel='icon' href='/favicon.svg' />
  </head>
  <body>
    <a class='skip' href='#editor'>Skip to editor</a>
    <header class='dash-header'>
      <a href='/' aria-label='Dura Fence Metal home' class='dash-brand'>
        <Monogram idPrefix='dashboard' crop class='dash-logo' />
        <span><span class='dash-wordmark'>Dura Fence Metal</span><small>Estimates and invoices</small></span>
      </a>
      <a class='link-quiet' href='/cdn-cgi/access/logout'>Sign out</a>
    </header>
    <main id='invoice-dashboard'>
      <div class='dash-title'>
        <div><p class='kicker'>Sales workspace</p><h1>Invoices</h1><p class='dash-muted'>Create estimates, manage invoices, and track payments.</p></div>
        <button class='btn-steel' type='button' data-action='new'>New estimate</button>
      </div>
      <div class='dash-notice' data-status role='status' aria-live='polite'>Loading workspace...</div>
      <section class='job-summary' aria-label='Current job summary'>
        <dl>
          <div><dt>Footage</dt><dd data-job-footage>0 ft</dd><span>Contracted fence</span></div>
          <div><dt>Openings</dt><dd data-job-openings>0 ft</dd><span data-job-gates>0 gates</span></div>
          <div><dt>Cameras</dt><dd data-job-cameras>0</dd><span data-job-camera-detail>0 included / 0 extra</span></div>
          <div class='job-total'><dt>Total</dt><dd data-job-total>$0.00</dd><span>Current document</span></div>
        </dl>
      </section>
      <section id='editor' class='dashboard-grid' aria-label='Document editor'>
        <div class='editor-column'>
          <div class='editor-toolbar'><div><p class='kicker' data-kind>Estimate</p><h2 data-number>New document</h2><p class='dash-muted' data-version>Not saved</p></div><button class='small-button' type='button' data-action='duplicate'>Duplicate</button></div>
          <form data-editor autocomplete='off'></form>
          <section class='dash-card' aria-labelledby='payments-title'><h2 id='payments-title'>Payments</h2><div data-payments></div>
            <form data-payment-form class='payment-form'>
              <label>Amount, USD<input name='amount' type='number' min='0.01' step='0.01' required /></label>
              <label>Date<input name='date' type='date' required /></label>
              <label>Method<input name='method' placeholder='Cash, card, bank transfer' maxlength='40' required /></label>
              <label>Note<input name='note' maxlength='500' /></label>
              <button class='small-button' type='submit'>Record payment</button>
            </form>
            <p class='dash-muted'>Manual payment records. Cards are not charged here.</p>
          </section>
          <section class='dash-card'><h2>Revision history</h2><div data-revisions><p class='dash-muted'>Save this document to start its revision history.</p></div></section>
        </div>
        <aside class='preview-column' aria-label='Totals and document'>
          <section class='dash-card summary-card'><h2>Document totals</h2><div data-summary aria-live='polite'></div><ul class='dash-errors' data-issues></ul>
            <div class='action-grid'>
              <button class='btn-steel' type='button' data-action='save'>Save changes</button>
              <button class='small-button' type='button' data-action='convert'>Convert to invoice</button>
              <button class='small-button' type='button' data-action='download'>Download PDF</button>
              <button class='small-button' type='button' data-action='print'>Print PDF</button>
              <button class='small-button' type='button' data-action='send'>Email customer</button>
            </div>
            <p class='dash-muted' data-save-note>Custom pricing applies to this document only.</p>
          </section>
          <section class='dash-card pdf-card' id='document-preview'><h2>PDF preview</h2><p class='dash-muted' data-preview-status>Complete the job details to generate a preview.</p><iframe data-preview title='Customer PDF preview' hidden></iframe></section>
        </aside>
      </section>
      <section class='dash-card history-card' aria-labelledby='history-title'>
        <div class='section-head'><h2 id='history-title'>Documents</h2><label class='search-label'>Search customers<input type='search' data-search placeholder='Customer name' autocomplete='off' /></label></div>
        <div class='table-scroll'><table><thead><tr><th>Document</th><th>Customer</th><th>Updated</th><th>Total</th><th>Balance</th><th><span class='sr-only'>Actions</span></th></tr></thead><tbody data-documents><tr><td colspan='6'>Loading documents...</td></tr></tbody></table></div>
        <button class='small-button' type='button' data-action='more' hidden>Load more</button>
      </section>
    </main>
    <script>
      import { mountDashboard } from '../invoice/dashboard';
      mountDashboard();
    </script>
  </body>
</html>
